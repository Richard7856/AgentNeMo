# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Required: NVIDIA NIM API key from https://build.nvidia.com/settings/api-keys
# Used for: LLM inference (llama-3.3-70b) and embeddings (nv-embedqa-e5-v5)
NVIDIA_API_KEY=nvapi-...

# Optional: Phoenix tracing observability
# Start Phoenix first: make phoenix
# Then set these env vars so NAT ships traces to it via OpenTelemetry:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
